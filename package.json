{
    "name": "minutia",
    "version": "1.0.0",
    "private": true,
    "homepage": "https://github.com/electrovir/minutia",
    "bugs": {
        "url": "https://github.com/electrovir/minutia/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/minutia.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspace minutia && npm run build --workspace demo && rm -rf dist-pages && cp -r packages/demo/dist dist-pages && cp -r packages/minutia/dist-docs dist-pages/docs",
        "compile": "virmator compile",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "npm start --workspace demo",
        "test": "npm run compile && mono-vir for-each-async npm run test",
        "test:all": "npm run test:coverage && runstorm --names spelling,format,docs,deps,lint,build \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\" \"npm run build\"",
        "test:coverage": "npm run compile && mono-vir for-each-async npm run test:coverage",
        "test:deps": "virmator deps check",
        "test:docs": "npm run test:docs --workspace minutia",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run compile && mono-vir for-each-async npm run test:update"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "cspell": "^10.0.1",
        "dependency-cruiser": "^18.1.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.2.0",
        "eslint-plugin-playwright": "^2.10.5",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "^72.0.0",
        "markdown-code-example-inserter": "^3.0.6",
        "mono-vir": "^2.5.0",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "~4.1.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "virmator": "^14.30.2"
    },
    "engines": {
        "node": ">=22"
    }
}
